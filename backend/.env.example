# Gemini API Configuration
GEMINI_API_KEY=AIzaSy... # Replace with your real Google Gemini API Key

# Model Configuration
MODEL_NAME="all-MiniLM-L6-v2"

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/dbname"

# Cache Configuration (Redis / LocalMemory fallback)
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL=600

# Job Scraper Configuration (Playwright)
ENABLE_SCRAPER=true
SCRAPER_TIMEOUT=15.0

# External API Integrations (RapidAPI JSearch)
JOB_API_KEY="your_rapidapi_jsearch_key"
MAX_RETRIES=3
JOB_FETCH_INTERVAL=10 # in minutes

# Google OAuth Integration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Security Configuration
JWT_SECRET="your_jwt_secret"
SESSION_SECRET="your_session_secret"
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
